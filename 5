<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Task Progress</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

<div class="container">
    <h2>Task Progress</h2>

    <table>
        <thead>
            <tr>
                <th>Task</th>
                <th>Status</th>
                <th>Deadline</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Design Mockup</td>
                <td><span class="status completed">Completed</span></td>
                <td>August 15</td>
            </tr>
            <tr>
                <td>Write Documentation</td>
                <td><span class="status progress">In Progress</span></td>
                <td>August 20</td>
            </tr>
            <tr>
                <td>Testing Phase</td>
                <td><span class="status pending">Pending</span></td>
                <td>August 25</td>
            </tr>
        </tbody>
    </table>
</div>

</body>
</html>
