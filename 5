body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
}

.container {
    width: 70%;
    margin: 50px auto;
    border: 2px solid #4CAF50;
    border-radius: 5px;
    overflow: hidden;
}

h2 {
    background-color: #4CAF50;
    color: white;
    text-align: center;
    margin: 0;
    padding: 15px;
}

table {
    width: 100%;
    border-collapse: collapse;
}

thead {
    background-color: #5ca65c;
    color: white;
}

th, td {
    padding: 15px;
    text-align: center;
    border: 1px solid #ddd;
}

tbody tr:nth-child(even) {
    background-color: #f2f2f2;
}

/* Status badges */
.status {
    padding: 8px 15px;
    border-radius: 20px;
    color: white;
    font-weight: bold;
}

.completed {
    background-color: #4CAF50;
}

.progress {
    background-color: #f0ad4e;
}

.pending {
    background-color: #d9534f;
}
